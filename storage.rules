rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn(){ return request.auth != null; }
    function staff(){ return signedIn() && request.auth.token.role in ['super_admin','content_admin','competition_admin','moderator']; }
    match /materials/{allPaths=**} { allow read: if signedIn(); allow write: if staff(); }
    match /profiles/{userId}/{allPaths=**} { allow read: if signedIn(); allow write: if signedIn() && request.auth.uid == userId; }
    // Group-file uploads stay disabled until a server-side membership check is wired.
    match /group-files/{groupId}/{allPaths=**} { allow read, write: if staff(); }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
